# -------------------------------------------
# F1TENTH 시뮬레이션용 Dockerfile (Humble / Coverage 제거 버전)
# -------------------------------------------

# 1. 베이스 이미지 (Humble Desktop)
FROM osrf/ros:humble-desktop

# 2. 리눅스 필수 도구 설치
# (그래픽 라이브러리 libgl1... 는 Rviz 실행을 위해 꼭 남겨두세요)
RUN apt-get update && apt-get install -y \
    python3-pip \
    git \
    nano \
    wget \
    curl \
    libgl1-mesa-glx \
    libgl1-mesa-dri \
    && rm -rf /var/lib/apt/lists/*

# --------------------------------------------------------
# [Python 환경 최적화]
# --------------------------------------------------------
# 1. pip 업그레이드
RUN pip3 install --upgrade pip

# 2. Setuptools 버전 고정 (Humble 빌드 경고 방지용 국룰)
RUN pip3 install setuptools==58.2.0

# 3. [핵심] Coverage 아예 삭제 (충돌 원천 차단)
# 혹시라도 시스템에 깔려있다면 지워버립니다.
RUN pip3 uninstall -y coverage

# 4. F1TENTH 필수 라이브러리 설치
# (empy는 ROS 2 빌드 시스템이 쓰므로 놔두는 게 안전합니다)
RUN pip3 install \
    numpy \
    scipy \
    pyyaml \
    pandas \
    shapely \
    empy==3.3.4

# --------------------------------------------------------

# 5. 작업 폴더 설정
WORKDIR /root/f1_team_5

# 6. 환경설정 자동 로드
RUN echo "source /opt/ros/humble/setup.bash" >> ~/.bashrc

# 7. 완료 메시지
RUN echo "Ready for F1TENTH Simulation (Clean Setup)!"